# =============================================================
# 根级环境变量示例（复制到 .env 后按需修改，.env 不入库）
# 说明：本文件仅作模板，真实值写在本地 .env 中。
# =============================================================

# 运行环境：development | test | production
NODE_ENV=development

# ---------- 服务端（Colyseus） ----------
# Colyseus 监听端口（WebSocket 与 HTTP 共用）
SERVER_PORT=2567
# Colyseus 默认房间名
ROOM_NAME=fps_battle
# 单个房间最大玩家数
ROOM_MAX_CLIENTS=10

# ---------- 安全增强 ----------
# 日志级别：trace | debug | info | warn | error | fatal（Pino）
LOG_LEVEL=info
# SQLite 审计数据库文件路径（相对 apps/server 目录解析）
AUDIT_DB_PATH=data/audit.db
# 审计日志保留天数
AUDIT_RETENTION_DAYS=30
# 单玩家每秒消息速率上限（防刷包）
RATE_LIMIT_PER_SECOND=30

# ---------- 监控（Prometheus / Grafana） ----------
# 服务端 /metrics 暴露端口（prom-client）
METRICS_PORT=9464
# Prometheus 服务端口
PROMETHEUS_PORT=9090
# Grafana 服务端口
GRAFANA_PORT=3000
# Grafana 初始管理员密码（仅本地开发使用）
GRAFANA_ADMIN_PASSWORD=admin
