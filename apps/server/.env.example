# =============================================================
# 服务端环境变量示例（复制到 apps/server/.env 后按需修改）
# 说明：路径类变量相对 apps/server 目录解析。
# =============================================================

# 运行环境：development | test | production
NODE_ENV=development

# Colyseus 监听端口
SERVER_PORT=2567
# 监听地址（0.0.0.0 允许局域网内其他设备/真机接入）
SERVER_HOST=0.0.0.0

# 默认房间名与容量
ROOM_NAME=fps_battle
ROOM_MAX_CLIENTS=10

# ---------- 安全增强 ----------
# Pino 日志级别：trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# 是否开启终端彩色日志（pino-pretty）
LOG_PRETTY=true
# 日志文件目录
LOG_DIR=logs

# SQLite 审计数据库
AUDIT_DB_PATH=data/audit.db
AUDIT_RETENTION_DAYS=30
# 审计写入是否异步批量落盘
AUDIT_ASYNC=true

# 单连接每秒消息速率上限（防刷包）
RATE_LIMIT_PER_SECOND=30
# 单条消息最大字节数
MAX_MESSAGE_BYTES=2048

# ---------- 监控 ----------
# prom-client 指标暴露端口（Prometheus 抓取 http://host.docker.internal:9464/metrics）
METRICS_PORT=9464
METRICS_ENABLED=true
